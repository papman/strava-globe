# ── Strava ────────────────────────────────────────────────────────────────────
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret

# In production, set this to your Railway backend URL:
# e.g. https://strava-globe-backend.up.railway.app/auth/callback
STRAVA_REDIRECT_URI=http://localhost:3001/auth/callback

# ── URLs ──────────────────────────────────────────────────────────────────────
# In production, set this to your Vercel frontend URL:
# e.g. https://strava-globe.vercel.app
FRONTEND_URL=http://localhost:5173

# ── Security ──────────────────────────────────────────────────────────────────
# Required when NODE_ENV=production. The server refuses to start if either
# value is missing. Local development uses a built-in fallback and prints a warning.
# Generate a strong random string for SESSION_SECRET, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-something-random

# Choose a strong password. Do not commit the real value.
ADMIN_PASSWORD=choose-a-strong-password

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development   # set to "production" on Railway
