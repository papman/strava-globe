{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://strava-globe-production-962e.up.railway.app/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://strava-globe-production-962e.up.railway.app/auth/:path*" },
    { "source": "/admin/login", "destination": "https://strava-globe-production-962e.up.railway.app/admin/login" },
    { "source": "/admin/logout", "destination": "https://strava-globe-production-962e.up.railway.app/admin/logout" },
    { "source": "/admin/stats", "destination": "https://strava-globe-production-962e.up.railway.app/admin/stats" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
